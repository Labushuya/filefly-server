# FileFly Server — configuration template.
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored and MUST stay out of version control — it holds your secret.

# --- REQUIRED ---
# HMAC signing key for JWTs. Anyone who knows this can forge admin tokens.
# The server REFUSES to start with the default/empty value.
#
# hubctl bootstrap replaces the __GENERATE_HEX32__ sentinel with a fresh
# `openssl rand -hex 32` on the Pi automatically. If you deploy by hand,
# set it yourself:  openssl rand -hex 32
SECRET_KEY=__GENERATE_HEX32__

# --- Optional (sensible defaults shown) ---
# Where uploads are stored INSIDE the container. In docker-compose this is
# pinned to the mounted volume (/data) and normally left as-is.
STORAGE_ROOT=/data

# How long an issued session token stays valid, in hours (default 7 days).
JWT_EXPIRE_HOURS=168

# Max size of a single upload chunk in MB.
MAX_CHUNK_SIZE_MB=10

# CORS origins. LAN-only setups can leave this as "*".
ALLOWED_ORIGINS=*
